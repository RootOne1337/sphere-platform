+#[cfg(target_arch = "wasm32")]
+fn request_surface_extents(pos: GPtr<f32>, scene_load: bool) {
+    use core::sync::atomic::Ordering::Relaxed;
+    if curr_area() != 0 || !EXTENT_SLOTS.iter().any(|s| s.load(Relaxed) != 0) { return; }
+    let px = pos.read();
+    let py = pos.wrapping_index(1).read();
+    let scale = g::<f32>(CAMERA + 0xF0).read();
+    if scene_load {
+        // The first vanilla big-building pass runs before the new IPLs arrive.
+        call_request_big_buildings(pos);
+    }
+    // Scan occupied static instances only, once per scene or once per 16 game frames.
+    // Bounds are native and transformed. The pivot of a visible street can lie
+    // outside the standard 80-unit streaming circle even directly under the observer.
+    for pool in [building_pool(), dummy_pool()] {
+        if pool.is_null() { continue; }
+        pool_backwards(pool, 0x38, |e| {
+            let slot = field::<u8, u8>(e, 0x2E).read() as usize;
+            if EXTENT_SLOTS[slot / 32].load(Relaxed) & (1 << (slot % 32)) == 0
+                || !in_current_area(e) || e_flags(e) & (0x80000 | 0x80) != 0x80 { return; }
+            let id = e_model(e);
+            if load_state(id) == 1 { return; }
+            let m = mi(id);
+            if m.is_null() || field::<GPtr<u8>, u8>(m, 0x14).read().is_null() { return; }
+            let draw = field::<f32, u8>(m, 0x18).read() * scale;
+            let radius = draw.min(180.0);
+            let mut rect = [0f32; 4];
+            crate::iplstore::entity_get_bound_rect(e, GPtr::from_raw(rect.as_mut_ptr()).cast());
+            let dx = (rect[0] - px).max(px - rect[2]).max(0.0);
+            let dy = (rect[3] - py).max(py - rect[1]).max(0.0);
+            let d2 = dx * dx + dy * dy;
+            if !(radius > 0.0 && d2 <= radius * radius) { return; }
+            let ti = mi_get_time_info(m);
+            if !ti.is_null() && clock_get_is_time_in_range(ti.read() as u32, ti.byte_add(1).read() as u32) == 0 { return; }
+            let flags = if scene_load { 0x20 } else { 0 };
+            call_request_model(id, flags | if d2 <= 65.0 * 65.0 { 0x10 } else { 0 });
+        });
+    }
+}
