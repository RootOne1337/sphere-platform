+// Only packed exterior IPLs use the extent pass. Keep their near meshes in the
+// regular collision sectors; registering them as visual LODs would remove physics.
+#[cfg(target_arch = "wasm32")]
+static EXTENT_SLOTS: [core::sync::atomic::AtomicU32; 8] =
+    [const { core::sync::atomic::AtomicU32::new(0) }; 8];
+
+#[cfg(target_arch = "wasm32")]
+pub(crate) fn mark_extent_slot(slot: i32, active: bool) {
+    use core::sync::atomic::Ordering::Relaxed;
+    if !(0..256).contains(&slot) { return; }
+    let bits = &EXTENT_SLOTS[slot as usize / 32];
+    let mask = 1 << (slot % 32);
+    if active { bits.fetch_or(mask, Relaxed); } else { bits.fetch_and(!mask, Relaxed); }
+}
