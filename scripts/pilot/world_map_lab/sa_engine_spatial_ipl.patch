+// BRC1 is the browser packer's spatial IPL. Its LOD indices refer to entities
+// in the same cell, allowing an entire LOD family to enter/leave the world together.
+#[cfg(target_arch = "wasm32")]
+fn load_world_cell(slot: i32, data: GPtr<u8>, size: i32, d: GPtr<IplDef>) -> u8 {
+    extern crate std;
+    let count = field::<u32,_>(data,4).read() as usize;
+    // BRC2 adds an explicit near-collider marker to each unmodified native instance.
+    let has_roles = field::<u32,_>(data,0).read() == u32::from_le_bytes(*b"BRC2");
+    let stride = if has_roles {44} else {40};
+    if count == 0 || count > 4096 || 8 + count * stride > size as usize {
+        return 0;
+    }
+    for i in 0..count {
+        let row = data.byte_add((8+i*stride) as isize);
+        let model = field::<i32,_>(row,28).read();
+        let lod = field::<i32,_>(row,36).read();
+        if !(0..20000).contains(&model) || model_info(model).is_null() ||
+            (has_roles && field::<u32,_>(row,40).read() > 1) || lod < -1 || lod >= count as i32 || lod == i as i32 {
+            return 0;
+        }
+    }
+    let first = fl(d,0) > fl(d,2) || fl(d,3) > fl(d,1);
+    let mut entities = std::vec::Vec::with_capacity(count);
+    for i in 0..count {
+        let row = data.byte_add((8+i*stride) as isize);
+        entities.push(load_object_instance_bin(row,GPtr::NULL));
+    }
+    let links = GPtr::from_raw(entities.as_mut_ptr());
+    for &entity in &entities {
+        link_lod(entity,slot,links,false);
+    }
+    for (i, &entity) in entities.iter().enumerate() {
+        let is_near = has_roles && field::<u32,_>(data, (8+i*stride+40) as isize).read() == 1;
+        crate::fileloader::prepare_lod_entity(entity, is_near);
+        entity_add(entity);
+        include_entity_call(slot,entity);
+        if first {
+            mark_large(d,entity);
+            let mut bounds=[0f32;4];
+            let _=entity_get_bound_rect(entity,GPtr::from_raw(bounds.as_mut_ptr()).cast());
+            let bb: GPtr<f32>=d.cast();
+            for (j,v) in bounds.into_iter().enumerate() {
+                let dst=bb.wrapping_index(j as i32);
+                if (j==0 || j==3) && v<dst.read() || (j==1 || j==2) && v>dst.read() {
+                    dst.write(v);
+                }
+            }
+        }
+    }
+    if first {
+        let bb: GPtr<f32>=d.cast();
+        let pad=if b(d,IS_LARGE).read()!=0 {350.0} else {200.0};
+        for (j,sign) in [-1.0,1.0,1.0,-1.0].into_iter().enumerate() {
+            let v=bb.wrapping_index(j as i32);
+            v.write(v.read()+pad*sign);
+        }
+        quad_add_item(QUAD_TREE.get(),d.cast(),d.cast());
+        enable_dynamic_streaming(slot,1);
+    }
+    b(d,LOADED).write(1);
+    1
+}
