{
  "valid_actions": {
    "start": {"type": "start", "legacy_note": "preserved"},
    "end": {"type": "end", "status": "success"},
    "tap": {"type": "tap", "x": 0, "y": 540, "reference_width": 960},
    "swipe": {"type": "swipe", "x1": 0, "y1": 0, "x2": 959, "y2": 539, "duration_ms": 1000},
    "type_text": {"type": "type_text", "text": "Пример 😀", "clear_first": false},
    "sleep": {"type": "sleep", "ms": 0},
    "key_event": {"type": "key_event", "keycode": 3},
    "lua": {"type": "lua", "code": "return true"},
    "screenshot": {"type": "screenshot", "save_to": "shot"},
    "condition": {"type": "condition", "check": "text_contains", "params": {"selector": "//node", "strategy": "xpath", "text": "OK"}, "on_true": "end", "on_false": "end"},
    "launch_app": {"type": "launch_app", "package": "com.android.settings", "delay_ms": 0},
    "stop_app": {"type": "stop_app", "package": "com.android.settings"},
    "clear_app_data": {"type": "clear_app_data", "package": "com.example.fixture"},
    "find_element": {"type": "find_element", "selector": "OK", "strategy": "text", "timeout_ms": 1000, "fail_if_not_found": true},
    "find_first_element": {"type": "find_first_element", "candidates": [{"selector": "ok", "strategy": "id", "label": "OK"}], "save_to": "match"},
    "tap_first_visible": {"type": "tap_first_visible", "candidates": [{"selector": "OK"}], "timeout_ms": 1000},
    "tap_element": {"type": "tap_element", "selector": "//*[@text='OK']", "strategy": "xpath"},
    "get_element_text": {"type": "get_element_text", "selector": "name", "strategy": "id", "attribute": "text"},
    "wait_for_element_gone": {"type": "wait_for_element_gone", "selector": "loading", "strategy": "desc", "timeout_ms": 0},
    "scroll_to": {"type": "scroll_to", "selector": "Save", "direction": "down", "max_scrolls": 10},
    "long_press": {"type": "long_press", "x": 100, "y": 100, "duration_ms": 500},
    "double_tap": {"type": "double_tap", "x": 100, "y": 100},
    "scroll": {"type": "scroll", "direction": "left", "percent": 0.45, "duration_ms": 350},
    "set_variable": {"type": "set_variable", "key": "value", "value": false},
    "get_variable": {"type": "get_variable", "key": "value"},
    "increment_variable": {"type": "increment_variable", "key": "counter", "step": -1},
    "shell": {"type": "shell", "command": "getprop ro.build.version.release", "fail_on_error": true},
    "input_clear": {"type": "input_clear"},
    "http_request": {"type": "http_request", "url": "https://example.com/path?a=1", "method": "post", "body": "", "headers": {"X-Fixture": "ok"}, "timeout_ms": 15000},
    "open_url": {"type": "open_url", "url": "market://details?id=com.example.fixture"},
    "get_device_info": {"type": "get_device_info", "save_to": "device"},
    "assert": {"type": "assert", "check": "text_contains", "params": {"selector": "name", "strategy": "id", "value": "OK"}}
  },
  "cases": [
    {"name": "missing tap coordinates", "action": {"type": "tap"}, "errors": ["x:required", "y:required"]},
    {"name": "sleep string", "action": {"type": "sleep", "ms": "not-a-number"}, "errors": ["ms:integer"]},
    {"name": "boolean is not coordinate", "action": {"type": "tap", "x": true, "y": 0}, "errors": ["x:integer"]},
    {"name": "fractional coordinate", "action": {"type": "tap", "x": 1.5, "y": 0}, "errors": ["x:integer"]},
    {"name": "negative coordinate", "action": {"type": "tap", "x": -1, "y": 0}, "errors": ["x:range"]},
    {"name": "integer overflow coordinate", "action": {"type": "tap", "x": 2147483648, "y": 0}, "errors": ["x:range"]},
    {"name": "missing long press coordinates", "action": {"type": "long_press"}, "errors": ["x:required", "y:required"]},
    {"name": "gesture duration bound", "action": {"type": "swipe", "x1": 0, "y1": 0, "x2": 1, "y2": 1, "duration_ms": 60001}, "errors": ["duration_ms:range"]},
    {"name": "variable object", "action": {"type": "set_variable", "key": "value", "value": {}}, "errors": ["value:primitive"]},
    {"name": "variable array", "action": {"type": "set_variable", "key": "value", "value": []}, "errors": ["value:primitive"]},
    {"name": "null variable preserved", "action": {"type": "set_variable", "key": "value", "value": null}, "errors": []},
    {"name": "variable absent source sets null", "action": {"type": "set_variable", "key": "value"}, "errors": []},
    {"name": "condition array params", "action": {"type": "condition", "check": "battery_above", "params": [], "on_true": "end", "on_false": "end"}, "errors": ["params:object"]},
    {"name": "battery unavailable is runtime concern", "action": {"type": "condition", "check": "battery_above", "on_true": "end", "on_false": "end"}, "errors": []},
    {"name": "battery threshold bound", "action": {"type": "condition", "check": "battery_above", "params": {"level": 101}, "on_true": "end", "on_false": "end"}, "errors": ["params.level:range"]},
    {"name": "condition native text field", "action": {"type": "condition", "check": "text_contains", "params": {"selector": "name", "value": "OK"}, "on_true": "end", "on_false": "end"}, "errors": ["params.text:required"]},
    {"name": "assert native value field", "action": {"type": "assert", "check": "text_contains", "params": {"selector": "name", "text": "OK"}}, "errors": ["params.value:required"]},
    {"name": "native check wins over Lua", "action": {"type": "condition", "check": "element_exists", "code": "return true", "on_true": "end", "on_false": "end"}, "errors": ["params:required"]},
    {"name": "Lua fallback condition", "action": {"type": "condition", "code": "return true", "on_true": "end", "on_false": "end"}, "errors": []},
    {"name": "missing condition expression", "action": {"type": "condition", "on_true": "end", "on_false": "end"}, "errors": ["check:check"]},
    {"name": "unsupported assert check", "action": {"type": "assert", "check": "battery_above"}, "errors": ["check:check"]},
    {"name": "assert variable primitive", "action": {"type": "assert", "check": "variable_equals", "params": {"key": "v", "value": 3}}, "errors": []},
    {"name": "empty selector", "action": {"type": "tap_element", "selector": " "}, "errors": ["selector:length"]},
    {"name": "unknown selector strategy", "action": {"type": "find_element", "selector": "OK", "strategy": "css"}, "errors": ["strategy:enum"]},
    {"name": "string boolean", "action": {"type": "type_text", "text": "", "clear_first": "true"}, "errors": ["clear_first:boolean"]},
    {"name": "empty text valid", "action": {"type": "type_text", "text": ""}, "errors": []},
    {"name": "empty candidates", "action": {"type": "find_first_element", "candidates": []}, "errors": ["candidates:length"]},
    {"name": "candidate scalar", "action": {"type": "tap_first_visible", "candidates": ["OK"]}, "errors": ["candidates.0:object"]},
    {"name": "candidate missing selector", "action": {"type": "tap_first_visible", "candidates": [{}]}, "errors": ["candidates.0.selector:required"]},
    {"name": "unsafe package characters", "action": {"type": "launch_app", "package": "com.app;reboot"}, "errors": ["package:pattern"]},
    {"name": "blank destructive target", "action": {"type": "clear_app_data", "package": ""}, "errors": ["package:length"]},
    {"name": "scroll percentage", "action": {"type": "scroll", "percent": 1.01}, "errors": ["percent:range"]},
    {"name": "http url scheme", "action": {"type": "http_request", "url": "file:///tmp/private"}, "errors": ["url:http_url"]},
    {"name": "http URL host missing", "action": {"type": "http_request", "url": "https://"}, "errors": ["url:http_url"]},
    {"name": "http URL port invalid", "action": {"type": "http_request", "url": "https://example.com:70000"}, "errors": ["url:http_url"]},
    {"name": "header value object", "action": {"type": "http_request", "url": "https://example.com", "headers": {"X-Test": {}}}, "errors": ["headers.<entry>:string"]},
    {"name": "header newline", "action": {"type": "http_request", "url": "https://example.com", "headers": {"X-Test": "PRIVATE\r\nOTHER"}}, "errors": ["headers.<entry>:pattern"]},
    {"name": "header name not reflected", "action": {"type": "http_request", "url": "https://example.com", "headers": {"PRIVATE BAD NAME": "ok"}}, "errors": ["headers.<entry>:pattern"]},
    {"name": "empty shell", "action": {"type": "shell", "command": " "}, "errors": ["command:length"]},
    {"name": "timeout not boolean", "action": {"type": "find_element", "selector": "OK", "timeout_ms": false}, "errors": ["timeout_ms:integer"]},
    {"name": "APK loop not published", "action": {"type": "loop", "body": []}, "errors": ["type:type"]},
    {"name": "prototype names not actions", "action": {"type": "__proto__"}, "errors": ["type:type"]}
  ]
}
