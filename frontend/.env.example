# Copy to .env.local and set values
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Server-only observability. Never prefix secrets/upstream addresses with NEXT_PUBLIC.
# Containers use service DNS; this example is for local Next + loopback tool ports.
OBSERVABILITY_AUTH_API_URL=http://127.0.0.1:18080/api/v1/
OBSERVABILITY_PROMETHEUS_URL=http://127.0.0.1:19090/
OBSERVABILITY_GRAFANA_URL=http://127.0.0.1:13000/
# Generate a private random value >=32 characters; no usable default is provided.
OBSERVABILITY_SESSION_SECRET=
# Must be true behind public HTTPS. false is only for loopback HTTP development.
OBSERVABILITY_SECURE_COOKIE=false
